let WM_TIMER: u32 = 0x0113;
let WM_MOUSEMOVE: u32 = 0x0200;
let WM_LBUTTONDOWN: u32 = 0x0201;
let WM_LBUTTONUP: u32 = 0x0202;
let WM_RBUTTONDOWN: u32 = 0x0204;
let WM_RBUTTONUP: u32 = 0x0205;
let WM_MBUTTONDOWN: u32 = 0x0207;
